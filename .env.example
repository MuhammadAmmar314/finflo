DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finflo?schema=public"

# Konfigurasi SMTP Pengiriman Email (Opsional)
# Jika dikosongkan, sistem berjalan dalam mode dev (OTP tampil di konsol server & banner antarmuka)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="emailkamu@gmail.com"
SMTP_PASS="app-password-kamu"
SMTP_FROM='"FinFlo" <noreply@finflo.app>'

# Link Pembelian FinFlo Pro di Lynk.id (Opsional)
NEXT_PUBLIC_LYNK_PRO_URL="https://lynk.id/finflo/finflo-pro"

